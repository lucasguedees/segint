rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Global Safety Net - Default Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Global Reusable Security Helpers ---
    
    function isSignedIn() {
      return request.auth != null;
    }

    function getUserData(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data;
    }

    function isApprovedUser() {
      return isSignedIn() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
        getUserData(request.auth.uid).status == "approved";
    }

    function isApprovedAdmin() {
      return isApprovedUser() && 
        getUserData(request.auth.uid).role == "admin";
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_-]+$');
    }

    // --- User Profile Rules ---
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isApprovedAdmin());
      allow list: if isSignedIn() && isApprovedAdmin();
      
      allow create: if isSignedIn() && request.auth.uid == userId && 
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 100 &&
        request.resource.data.email is string && request.resource.data.email.size() > 0 && request.resource.data.email.size() <= 100 &&
        request.resource.data.createdAt is string &&
        (
          // Bootstrapping: Owner of the workspace is auto-approved as Admin (case-insensitive)
          (request.resource.data.email.lower() == "lucas2305rj1994@gmail.com" && request.resource.data.role == "admin" && request.resource.data.status == "approved") ||
          // All other users start as pending
          (request.resource.data.role == "user" && request.resource.data.status == "pending")
        );
        
      allow update: if isSignedIn() && (
        // The workspace owner can always upgrade or set their own role/status to admin/approved
        (request.auth.uid == userId &&
          request.resource.data.uid == resource.data.uid &&
          request.resource.data.email.lower() == "lucas2305rj1994@gmail.com" &&
          request.resource.data.role == "admin" &&
          request.resource.data.status == "approved"
        ) ||
        // Admins can update roles and statuses for any user
        (isApprovedAdmin() && 
          request.resource.data.uid == resource.data.uid &&
          request.resource.data.name is string && request.resource.data.name.size() > 0 &&
          request.resource.data.role in ["admin", "user"] &&
          request.resource.data.status in ["approved", "pending", "rejected"]
        ) ||
        // Regular users can update their own details but CANNOT modify role or status
        (request.auth.uid == userId &&
          request.resource.data.uid == resource.data.uid &&
          request.resource.data.email == resource.data.email &&
          request.resource.data.role == resource.data.role &&
          request.resource.data.status == resource.data.status &&
          request.resource.data.name is string && request.resource.data.name.size() > 0
        )
      );
      
      allow delete: if isSignedIn() && isApprovedAdmin();
    }

    // --- Suspect Rules ---
    match /suspects/{suspectId} {
      allow read, list: if isApprovedUser();
      
      allow create: if isApprovedUser() && isValidId(suspectId) &&
        request.resource.data.id == suspectId &&
        request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 100 &&
        request.resource.data.status in ["wanted", "arrested", "investigating", "inactive"];
        
      allow update: if isApprovedUser() && isValidId(suspectId) &&
        request.resource.data.id == suspectId &&
        request.resource.data.name is string && request.resource.data.name.size() > 0;
        
      allow delete: if isApprovedUser();
    }

    // --- Occurrence Rules ---
    match /occurrences/{occurrenceId} {
      allow read, list: if isApprovedUser();
      
      allow create: if isApprovedUser() && isValidId(occurrenceId) &&
        request.resource.data.id == occurrenceId &&
        request.resource.data.title is string && request.resource.data.title.size() > 0;
        
      allow update: if isApprovedUser() && isValidId(occurrenceId) &&
        request.resource.data.id == occurrenceId &&
        request.resource.data.title is string && request.resource.data.title.size() > 0;
        
      allow delete: if isApprovedUser();
    }

    // --- Audit Log Rules ---
    match /audit_logs/{logId} {
      allow read, list: if isApprovedUser();
      
      // Any approved user can record an audit trail event
      allow create: if isApprovedUser() && isValidId(logId) &&
        request.resource.data.id == logId &&
        request.resource.data.action is string &&
        request.resource.data.timestamp is string;
        
      // Immutable logs - no updates allowed. Only admin can prune if needed.
      allow update: if false;
      allow delete: if isApprovedAdmin();
    }
  }
}
